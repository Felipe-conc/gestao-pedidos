unit uglobal_vars;

interface

uses
  System.IniFiles, System.SysUtils, System.IOUtils;

var
  gb_defaultdir : string;
  gb_database : string;

  gb_username : string;
  gb_password : string;

  gb_base_url : string;
  gb_token : string;
  gb_data : string;
  gb_estabelecimento : integer;
  gb_codigo : integer;


implementation

procedure carregaConfig;
var
  vConfig : TIniFile;
  vPath, vPathDB, vPathReport : string;
begin
  vPath := gb_defaultdir + 'config.ini';
  vConfig := TIniFile.Create(vPath);
  try
    vPathDB := gb_defaultdir + 'bd\';
    if not TDirectory.Exists(vPathDB) then
      TDirectory.CreateDirectory(vPathDB);

    vPathReport := gb_defaultdir + 'reports\';
    if not TDirectory.Exists(vPathReport) then
      TDirectory.CreateDirectory(vPathReport);

    if not FileExists(vPath) then
    begin
      vConfig.WriteString('conexao', 'database', vPathDB + 'banco.db');
      vConfig.WriteString('conexao', 'username', 'user');
      vConfig.WriteString('conexao', 'password', 'pass');
      vConfig.WriteString('conexao', 'token', '123');
      vConfig.WriteString('conexao', 'codigo', '1');
    end;

    gb_database        := vConfig.ReadString('conexao', 'database', vPathDB + 'banco.db');
    gb_username        := vConfig.ReadString('conexao', 'username', 'user');
    gb_password        := vConfig.ReadString('conexao', 'password', 'pass');
    gb_token           := vConfig.ReadString('conexao', 'token', '123');
    gb_codigo          := StrToInt(vConfig.ReadString('conexao', 'codigo', '1'));

  finally
    FreeAndNil(vConfig);
  end;
end;

initialization
  gb_defaultdir := ExtractFilePath(ParamStr(0));
  carregaConfig;
  gb_base_url := 'http://192.168.1.87:7476';
//  gb_base_url := 'http://lucedata.com.br:7476';

end.
