procedure TfPrincipal.carregaPedidos;
var
  vResponse : string;
  vJSONArray : TJSONArray;
  vObj : TJSONObject;
  vInt, vId: Integer;
begin
  //vResponse := httpPedidos.Get('get/pedidos');
//  vResponse := '[{"id":1,"descricao":"Pedido A", "impresso":"N", "mensagem": "exemplo 1"},'
//               +'{"id":2,"descricao":"Pedido B", "impresso":"N", "mensagem": "exemplo 2"}]';

  vResponse := '[{"id":1,"descricao":"Pedido #1001", "impresso":"N", "mensagem": "Mesa 5\nCliente: João\n\n1x X-Burger\n1x Batata Frita Média\n1x Coca-Cola Lata\n\nObservação: Sem cebola\n\nTotal: R$ 32,90"},'
             +'{"id":2,"descricao":"Pedido #1002", "impresso":"N", "mensagem": "Balcão\nCliente: Maria\n\n2x X-Salada\n1x Suco de Laranja\n\nObservação: Ponto da carne bem passado\n\nTotal: R$ 45,50"}]';

  if vResponse <> '' then begin
    vJSONArray := TJSONArray(TJSONObject.ParseJSONValue(vResponse));

    try
      for vInt := 0 to Pred(vJSONArray.Count) do begin
        vObj := TJSONObject(vJSONArray.Items[vInt]);
        vId  := StrToInt(vObj.GetValue('id').Value);

        if memPedido.Locate('Id', vId, []) then
          Continue;

        memPedido.Append;
        memPedidoId.AsInteger       := vId;
        memPedidoDescricao.AsString := vObj.GetValue('descricao').Value;
        memPedidoMensagem.AsString  := vObj.GetValue('mensagem').Value;
        memPedidoImpresso.AsString  := vObj.GetValue('impresso').Value;
        memPedido.Post;
      end;

    finally
      vJSONArray.Free;
    end;

    imprimirPedidos;
  end;
end;

