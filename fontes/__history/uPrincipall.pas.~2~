procedure TfPrincipal.imprimirPedidos;
var
  vInt : integer;
begin
  if memPedido.IsEmpty then
    Exit;

  memPedido.First;

  while not memPedido.Eof do begin

    if memPedidoImpresso.AsString = 'N' then begin

      memPedido.Filter := 'id = ' + memPedidoId.AsString;
      memPedido.Filtered := True;

//      frqPedido.ShowReport;

      frqPedido.PrintOptions.ShowDialog := False;
      frqPedido.PrepareReport();
      frqPedido.Print;

      memPedido.Edit;
      memPedidoImpresso.AsString := 'S';
      memPedido.Post;

      memPedido.Filtered := False;
    end;

    memPedido.Next;
  end;
end;



