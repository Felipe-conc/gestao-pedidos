unit uglobal_vars;

interface

uses
  System.IniFiles, System.SysUtils, System.IOUtils;

var
  gb_defaultdir : string;
  gb_database : string;

  gb_username : string;
  gb_password : string;

  gb_base_url : string;
  gb_token : string;
  gb_data : string;
  gb_estabelecimento : integer;
  gb_codigo : integer;


implementation

procedure carregaConfig;
var
  vConfig : TIniFile;
  vPath, vPath2 : string;
begin
  vPath := gb_defaultdir + 'config.ini';
  vConfig := TIniFile.Create(vPath);
  try
    vPath2 := gb_defaultdir + 'bd\';

    if not TDirectory.Exists(vPath2) then
      TDirectory.CreateDirectory(vPath2);

    if not FileExists(vPath) then
    begin
      vConfig.WriteString('conexao', 'database', vPath2 + 'banco.db');
      vConfig.WriteString('conexao', 'username', 'user');
      vConfig.WriteString('conexao', 'password', 'pass');
      vConfig.WriteString('conexao', 'token', '123');
      vConfig.WriteString('conexao', 'codigo', '1');
      vConfig.WriteString('conexao', 'data', '2026-01-01 00:00:01');
    end;

    gb_database := vConfig.ReadString('conexao', 'database', vPath2 + 'banco.db');
    gb_username := vConfig.ReadString('conexao', 'username', 'user');
    gb_password := vConfig.ReadString('conexao', 'password', 'pass');
    gb_token    := vConfig.ReadString('conexao', 'token', '123');
    gb_codigo   := StrToInt(vConfig.ReadString('conexao', 'codigo', '1'));
    gb_data     := vConfig.ReadString('conexao', 'data', '2026-01-01 00:00:01');

  finally
    FreeAndNil(vConfig);
  end;
end;

initialization
  gb_defaultdir := ExtractFilePath(ParamStr(0));
  carregaConfig;
  gb_base_url := 'http://192.168.1.87:7476';

end.
