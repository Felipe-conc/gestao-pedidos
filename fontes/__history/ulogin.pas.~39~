unit ulogin;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, uform_modelo, Vcl.ExtCtrls, Vcl.StdCtrls,
  Vcl.Imaging.pngimage, uglobal_vars, System.IniFiles, IdBaseComponent,
  IdComponent, IdTCPConnection, IdTCPClient, IdHTTP;

type
  Tflogin = class(Tfform_modelo)
    pLogo: TPanel;
    pImagem: TPanel;
    pCentral: TPanel;
    Label1: TLabel;
    eEmail: TEdit;
    Label2: TLabel;
    eSenha: TEdit;
    Label3: TLabel;
    bEntrar: TButton;
    iLogo: TImage;
    iImpressora: TImage;
    bSair: TButton;
    httpLogin: TIdHTTP;
    Timer: TTimer;
    procedure bSairClick(Sender: TObject);
    procedure bEntrarClick(Sender: TObject);
    procedure TimerTimer(Sender: TObject);
  private
    { Private declarations }
    function confereCampos : boolean;
    function paramCriado : boolean;
    procedure gravarParam;
    function requisicaoLogin(AEmail, ASenha : string) : boolean;
  public
    { Public declarations }
  end;

var
  flogin: Tflogin;

implementation

{$R *.dfm}

uses uPrincipal, System.JSON, uselec_estabelecimento, FireDAC.Comp.Client, udm;

procedure Tflogin.bEntrarClick(Sender: TObject);
var
  vConfig : TIniFile;
  vPath : string;
begin
  inherited;
  if not confereCampos then
    Exit;

  if requisicaoLogin(eEmail.Text, eSenha.Text) = false then
    Exit;

  ModalResult := mrOk;
  if Assigned(fPrincipal) then 
    fPrincipal.habilitaTela;

  vPath := gb_defaultdir + 'config.ini';
  vConfig := TIniFile.Create(vPath);
  try
    if gb_username <> eEmail.Text then begin
      vConfig.WriteString('conexao', 'username', eEmail.Text);
      gb_username := vConfig.ReadString('conexao', 'username', 'user');
    end;

    if gb_password <> eSenha.Text then begin
      vConfig.WriteString('conexao', 'password', eSenha.Text);
      gb_password := vConfig.ReadString('conexao', 'password', 'pass');
    end;

//    if vConfig.ReadString('conexao', 'codigo', '1') <> IntToStr(gb_codigo) then
//      vConfig.WriteString('conexao', 'codigo', IntToStr(gb_codigo));

    if vConfig.ReadString('conexao', 'token', '123') <> gb_token then
      vConfig.WriteString('conexao', 'token', gb_token);
  finally
    FreeAndNil(vConfig);
  end;
end;

procedure Tflogin.bSairClick(Sender: TObject);
begin
  inherited;
  Application.Terminate;
end;

function Tflogin.confereCampos: boolean;
begin
  Result := True;

  if Timer.Enabled then begin
    ShowMessage('Aguarde alguns segundos e tente novamente!');
    Result := False;
    Exit;
  end;
  
  if eEmail.Text = '' then begin
    ShowMessage('E-mail deve ser informado!');
    Result := False;
    Exit;
  end;

  if eSenha.Text = '' then begin
    ShowMessage('Senha deve ser informado!');
    Result := False;
    Exit;
  end;
end;

procedure Tflogin.gravarParam;
var
  q1: TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Close;
    q1.SQL.Clear;
    q1.Connection := dm.conexao;
    q1.SQL.Add('INSERT OR REPLACE INTO param (id, id_estabelecimento) ');
    q1.SQL.Add('VALUES (1, :id_estabelecimento)');

    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    q1.Free;
  end;
end;

function Tflogin.paramCriado: boolean;
var
  q1 : TFDQuery;
begin
  Result := False;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('SELECT id_estabelecimento FROM param LIMIT 1');
    q1.Open;
    if not q1.IsEmpty then begin
      gb_estabelecimento := q1.FieldByName('id_estabelecimento').AsInteger;
      Result := true;
    end;
  finally
    FreeAndNil(q1);
  end;
end;

function Tflogin.requisicaoLogin(AEmail, ASenha: string): boolean;
var
  vJsonToSend: TStringStream;
  vResponse, j, vErro, vJson : string;
  vObj,vEstabel : TJSONObject;
  vArrayEstabel : TJSONArray;
  vQtdEstabel, vInt : integer;
begin
  Result := False;
//  httpLogin.Request.CacheControl := 'no-cache';
//  httpLogin.Request.ContentType  := 'application/json';
//  httpLogin.Request.ContentEncoding:= 'utf-8';

//  j:= '{ "email": "' +AEmail+ '",' +
//      '"senha": "' +ASenha+ '" }';

  j:= '{ "email": "teste@gmail.com",' +
      '"senha": "123123" }';

  try
    vJsonToSend := TStringStream.Create(j, TEncoding.UTF8);
    try
      vResponse := httpLogin.Post(gb_base_url + '/login', vJsonToSend);
    except
      on E: Exception do begin
        ShowMessage('Falha de conexão com o servidor.');
        Exit;
      end;
    end;

  finally
    vJsonToSend.Free;
  end;

  vObj := TJSONObject(TJSONObject.ParseJSONValue(vResponse));
  if vObj.TryGetValue<string>('error', vErro) then begin
    if vObj.GetValue('error').Value = 'no_establishments_linked' then
      ShowMessage('Seu usuário não possui estabelecimentos vinculados. Procure o suporte do sistema!')
    else
      ShowMessage('Usuário ou senha inválidos!');

    Exit;
  end
  else begin
    gb_token := vObj.GetValue('token').Value;

    if paramCriado then begin
      if gb_estabelecimento = StrToInt(vObj.GetValue('id_est').Value) then begin
        Result := True;
        Exit;
      end;

      vArrayEstabel := TJSONArray(vObj.GetValue('estabelecimentos'));
      for vInt := 0 to Pred(vArrayEstabel.Count) do begin
        vEstabel := TJSONObject(vArrayEstabel.Items[vInt]);

        if gb_estabelecimento = StrToInt(vEstabel.GetValue('id').Value) then begin
          Result := True;
          Exit;
        end;
      end;
    end;

    vQtdEstabel := TJSONArray(vObj.GetValue('estabelecimentos')).Count;

    if (vQtdEstabel > 1) then begin
      try
        fSelec_Estabelecimento := TfSelec_Estabelecimento.Create(nil);
        vArrayEstabel := TJSONArray(vObj.GetValue('estabelecimentos'));

        for vInt := 0 to Pred(vQtdEstabel) do begin
          vEstabel := TJSONObject(vArrayEstabel.Items[vInt]);

          fSelec_Estabelecimento.memEstabel.Append;
          fSelec_Estabelecimento.memEstabelID.AsInteger := StrToInt(vEstabel.GetValue('id').Value);
          fSelec_Estabelecimento.memEstabelFantasia.AsString := vEstabel.GetValue('fantasia').Value;
          fSelec_Estabelecimento.memEstabel.Post;
        end;
        flogin.Hide;
        fSelec_Estabelecimento.ShowModal;
      finally
        FreeAndNil(fSelec_Estabelecimento);
        FreeAndNil(vArrayEstabel);
      end;
    end
    else begin
      gb_estabelecimento := StrToInt(vObj.GetValue('id_est').Value);
    end;

    if not paramCriado then begin
      if gb_estabelecimento = -1 then begin
        ShowMessage('Seu usuário não possui estabelecimentos vinculados! Procure o suporte do sistema.');
        Application.Terminate;
      end;

      gravarParam;
    end;

    Result := True;
  end;
end;

procedure Tflogin.TimerTimer(Sender: TObject);
begin
  inherited;
  Timer.Enabled := False;
end;

end.
