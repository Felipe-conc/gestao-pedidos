procedure TfPrincipal.thrRetorno(ASender: TObject; AJson: string; var AUltimoCodigo : integer);
var
  vJSONArray : TJSONArray;
  vInt, vId : integer;
  vObj : TJSONObject;
begin
  if AJson <> '[]' then begin
    vJSONArray := TJSONArray(TJSONObject.ParseJSONValue(AJson));
    try
      for vInt := 0 to Pred(vJSONArray.Count) do begin
        vObj   := TJSONObject(vJSONArray.Items[vInt]);
        vId    := StrToInt(vObj.GetValue('id').Value);

        if memPedido.Locate('Id', vId, []) then
          Continue;

        gravaMemTable(vObj, vId);
//        imprimirPedidos(vId);
      end;
    finally
      AUltimoCodigo := FUltimoCodigo;
      vJSONArray.Free;
    end;
  end;
end;

