  vItens, vFormasPagt : TJSONArray;
  vObj2, vCupom : TJSONObject;
  vInt2, vInt3: Integer;
  vData, vDataUTC : TDateTime;
begin
  if AId > FUltimoCodigo then
    FUltimoCodigo := AId;

  vCupom := TJSONObject(TJSONObject.ParseJSONValue(AObj.GetValue('cupom').Value));
  memPedido.Append;
  memPedidoId.AsInteger         := AId;
  if ACodDescricao <> 0 then
    memPedidoDescricao.AsString := 'Pedido #' + IntToStr(ACodDescricao)
  else
    memPedidoDescricao.AsString := 'Pedido #' + IntToStr(gb_codigo);

  memPedidoTelefone.AsString    := vCupom.GetValue('numero_telefone').Value;
  memPedidoPreco_total.AsString := vCupom.GetValue('preco_total').Value;
  memPedidoObservacao.AsString  := GetStrOrEmpty(vCupom, 'observacao');
  memPedidoEndereco.AsString    := GetStrOrEmpty(vCupom, 'endereco');
  memPedidoTroco.AsString       := GetStrOrEmpty(vCupom, 'troco');
  memPedidoIdx_status.AsInteger := AStatus;

  case AStatus of
    0: memPedidoStatus.AsString := 'Confirmado';
    1: memPedidoStatus.AsString := 'Em preparo';
    2: memPedidoStatus.AsString := 'Pronto';
    3: memPedidoStatus.AsString := 'Saiu para Entrega';
    4: memPedidoStatus.AsString := 'Entregue';
    5: memPedidoStatus.AsString := 'Cancelado';
  end;

  vFormaStr := '';
  vFormasPagt := TJSONArray(vCupom.GetValue('formas_pagamento'));
  for vInt3 := 0 to Pred(vFormasPagt.Count) do begin
    if vFormaStr <> '' then
      vFormaStr := vFormaStr + ', ';

    vFormaStr := vFormaStr + vFormasPagt.Items[vInt3].Value;
  end;

  memPedidoFormas_pagt.AsString := vFormaStr;

  if AObj.TryGetValue<string>('data', vDataStr) and (vDataStr <> '') then begin
    vDataUTC := ISO8601ToDate(vDataStr);
    vData := TTimeZone.Local.ToLocalTime(vDataUTC);
    memPedidoData.AsDateTime := vData;
  end
  else begin
    memPedidoData.Clear;
  end;

  memPedidoImpresso.AsString := AImpresso;
  memPedido.Post;

  vItens := TJSONArray(vCupom.GetValue('pedidos'));
  memItens.DisableControls;
  for vInt2 := 0 to Pred(vItens.Count) do begin
    vObj2 := TJSONObject(vItens.Items[vInt2]);
    memItens.Append;
    memItensId.AsInteger         := AId;
    memItensNome.AsString        := GetStrOrEmpty(vObj2, 'nome');
    memItensQuantidade.AsInteger := StrToInt(vObj2.GetValue('quantidade').Value);
    memItensPreco_total.AsFloat  := StrToFloat(vObj2.GetValue('preco_total').Value);
    memItensObservacao.AsString  := GetStrOrEmpty(vObj2, 'observacao');
    memItens.Post;
  end;
  memItens.EnableControls;

  contaPedidos;
  if not existePedido(AId) then
    gravaPedido(AObj.ToString, AId, AStatus, vData, gb_codigo);
  addUltimoCodigo;
end;

procedure TfPrincipal.gravaPedido(AJson: string; AId, AStatus: integer;
                                  AData : TDateTime; ACodDescricao : integer);
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('insert into pedidos (id, json, status, data, codigo_descricao, id_estabelecimento)');
    q1.SQL.Add('values (:id, :json, :status, :data, :codigo_descricao, :id_estabelecimento)');
    q1.ParamByName('id').AsInteger                 := AId;
    q1.ParamByName('json').AsString                := AJson;
    q1.ParamByName('status').AsInteger             := AStatus;
    q1.ParamByName('data').AsDateTime              := AData;
    q1.ParamByName('codigo_descricao').AsInteger   := ACodDescricao;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.ExecSQL;

  finally
    FreeAndNil(q1);
  end;
end;

