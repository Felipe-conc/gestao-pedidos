procedure TfPrincipal.addUltimoCodigo;
var
  vConfig : TIniFile;
  vPath : string;
begin
  gb_codigo := gb_codigo + 1;
  vPath := gb_defaultdir + 'config.ini';
  vConfig := TIniFile.Create(vPath);
  try
    vConfig.WriteString('conexao', 'codigo', IntToStr(gb_codigo));
  finally
    FreeAndNil(vConfig);
  end;
end;

procedure TfPrincipal.alterarStatus(AId, AIdx_status: integer);
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('update pedidos');
    q1.SQL.Add('  set status = :status');
    q1.SQL.Add('where id = :id');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('id').AsInteger                 := AId;
    q1.ParamByName('status').AsInteger             := AIdx_status;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.ExecSQL;

  finally
    FreeAndNil(q1);
  end;
  contaPedidos;
end;

