  case memPedidoIdx_status.AsInteger of
    0: gPedidos.Canvas.Brush.Color := clWhite;   // Confirmado
    1: gPedidos.Canvas.Brush.Color := $00A0FFFF; // Em preparo
    2: gPedidos.Canvas.Brush.Color := $00A0FFA0; // Pronto
    3: gPedidos.Canvas.Brush.Color := $00FFB070; // Saiu entrega
    4: gPedidos.Canvas.Brush.Color := $00E0E0E0; // Entregue
    5: gPedidos.Canvas.Brush.Color := $000000FF; // Cancelado
  end;
  gPedidos.DefaultDrawColumnCell(Rect, DataCol, Column,State);
end;

