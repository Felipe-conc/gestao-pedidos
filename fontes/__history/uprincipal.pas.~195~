procedure TfPrincipal.imprimirPedidos(AId : integer = 0);
var
  s : string;
  lista : TStringList;
begin
  if memPedido.IsEmpty then
    Exit;
  lista := TStringList.Create;

  memPedido.First;
  while not memPedido.Eof do begin
    lista.Clear;
    if AId <> 0 then begin
      if memPedido.Locate('Id', AId, []) then begin
        memPedido.Edit;
        memPedidoImpresso.AsString := 'N';
        memPedido.Post;
      end;
    end;

    if memPedidoImpresso.AsString = 'N' then begin
      lista.Add('</zera></ce><n>AcheiVC</n>');
      lista.Add('</ce><n>'+memPedidoDescricao.AsString+'</n>');
      lista.Add('</ce><n>'+DateToStr(memPedidoData.AsDateTime)+' | '+TimeToStr(memPedidoData.AsDateTime)+'</n>');

      if memPedidoTelefone.AsString <> '' then
        lista.Add('</ae>Telefone: '+memPedidoTelefone.AsString);

      if memPedidoEndereco.AsString <> '' then
        lista.Add('</ae>Endereço: '+memPedidoEndereco.AsString);

      if memPedidoObservacao.AsString <> '' then
        lista.Add('<n>OBS:</n> '+memPedidoObservacao.AsString);

      lista.Add('');
      lista.Add('<n>ITENS</n>');
      memItens.First;
      while not memItens.Eof do begin
        if memPedidoId.AsInteger = memItensId.AsInteger then begin
          lista.Add('</ae> -'+IntToStr(memItensQuantidade.AsInteger)+'x '+memItensNome.AsString);
          if memItensObservacao.AsString <> '' then
            lista.Add('<n>  OBS:</n> '+memItensObservacao.AsString);

          lista.Add('<n>  SubTotal: R$ '+FloatToStr(memItensPreco_total.AsFloat)+'</n>');
          lista.Add('');
        end;

        memItens.Next;
      end;

      if memPedidoFormas_pagt.AsString <> '' then
        lista.Add('<n>Forma pagt:</n> '+memPedidoFormas_pagt.AsString);

      if memPedidoTroco.AsString <> '' then
        lista.Add('<n>Troco para '+memPedidoTroco.AsString + '</n>');

      lista.Add('</ad><n>Total: R$ '+FloatToStr(memPedidoPreco_total.AsFloat)+'</n>');
      lista.Add('');
      lista.Add('');
      lista.Add('</ce><n>===================</n>');
      lista.Add('</corte_total>');

      if (FModelo < 0) or (FPorta = '') then begin
        ShowMessage('Impressora não foi configurada!');
      end
      else begin
        ACBrPosPrinter1.Modelo             := TACBrPosPrinterModelo(FModelo);
        ACBrPosPrinter1.Porta              := FPorta;
        ACBrPosPrinter1.PaginaDeCodigo     := TACBrPosPaginaCodigo(FPagCodigo);
        ACBrPosPrinter1.CortaPapel         := FCortarPapel;
        ACBrPosPrinter1.EspacoEntreLinhas  := FEspLinhas;
        ACBrPosPrinter1.LinhasEntreCupons  := FLinhasPular;
        ACBrPosPrinter1.ColunasFonteNormal := FColunas;

        ACBrPosPrinter1.Ativar;
        try
          ACBrPosPrinter1.Buffer.Text := lista.Text;
          ACBrPosPrinter1.Imprimir;
        finally
          ACBrPosPrinter1.Desativar;
        end;
      end;

      memPedido.Edit;
      memPedidoImpresso.AsString := 'S';
      memPedido.Post;

       if AId <> 0 then
         Exit;
    end;

    memPedido.Next;
  end;
  lista.free;
end;

