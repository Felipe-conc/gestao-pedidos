procedure TfPrincipal.contaPedidos;
var
  vStatus : integer;
begin
  FTotalPedidos      := 0;
  FPedidosPendentes  := 0;
  FPedidosCancelados := 0;

  memPedido.First;
  while not memPedido.Eof do begin
    vStatus := memPedidoIdx_status.AsInteger;
    if (vStatus = status_confirmado) or (vStatus = status_em_preparo) or
         (vStatus = status_pronto) or (vStatus = status_saiu_entrega) then
       FPedidosPendentes := FPedidosPendentes + 1
    else if vStatus = status_cancelado then
      FPedidosCancelados := FPedidosCancelados + 1;

    FTotalPedidos := FTotalPedidos + 1;

    memPedido.Next;
  end;

  lTotalPedidos.Caption      := IntToStr(FTotalPedidos);
  lPedidosPendentes.Caption  := IntToStr(FPedidosPendentes);
  lPedidosCancelados.Caption := IntToStr(FPedidosCancelados);
end;

