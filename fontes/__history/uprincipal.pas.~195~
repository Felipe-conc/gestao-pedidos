procedure TfPrincipal.carregaConfigImpressora;
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.SQL.Clear;
    q1.SQL.Add('select modelo_impressora, porta_imp, pagina_codigo_imp, corta_papel_imp,');
    q1.SQL.Add('       espaco_entre_linhas_imp, linhas_entre_cupons_imp, colunas_imp');
    q1.SQL.Add('from param');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := 1;
    q1.Open;

    if not q1.Eof then begin
      FModelo    := q1.FieldByName('modelo_impressora').AsInteger;
      FPorta     := q1.FieldByName('porta_imp').AsString;
      FPagCodigo := q1.FieldByName('pagina_codigo_imp').AsInteger;

      FCortarPapel := False;
      if q1.FieldByName('corta_papel_imp').AsString = 'S' then
        FCortarPapel := True;

      FEspLinhas   := q1.FieldByName('espaco_entre_linhas_imp').AsInteger;
      FLinhasPular := q1.FieldByName('linhas_entre_cupons_imp').AsInteger;
      FColunas     := q1.FieldByName('colunas_imp').AsInteger;
    end;
  finally
    FreeAndNil(q1);
  end;
end;

procedure TfPrincipal.carregaPedidos(AData : integer = 0);
var
  vResponse, j : string;
  vJSONArray : TJSONArray;
  vObj : TJSONObject;
  vInt, vId: Integer;
  vJsonToSend: TStringStream;
  vResponseStream: TStringStream;
begin
  repetirValidacao;
  httpPedidos.Request.ContentType := 'application/json; charset=utf-8';
  httpPedidos.Request.CacheControl := 'no-cache';
  httpPedidos.Response.CharSet := 'utf-8';
  httpPedidos.Request.CharSet := 'utf-8';

  if AData = 0 then begin
    j := '{"id_estabelecimento": "'+IntToStr(gb_estabelecimento)+'",'+
        '"ultimo_id": "'+ IntToStr(FUltimoCodigo) +'",'+
        '"token": "'+gb_token+'"}';

    vJsonToSend := TStringStream.Create(j, TEncoding.UTF8);
    vResponseStream := TStringStream.Create('', TEncoding.UTF8);
    try
      try
        httpPedidos.Post(gb_base_url + '/cupons_apos_id', vJsonToSend, vResponseStream);
        vResponse := vResponseStream.DataString;
      except
        on E: Exception do begin
          ShowMessage('Falha de conexão com o servidor.');
          Exit;
        end;
      end;

    finally
      FreeAndNil(vJsonToSend);
      FreeAndNil(vResponseStream);
    end;
  end
  else begin
    j := '{"id_estabelecimento": "'+IntToStr(gb_estabelecimento)+'",'+
        '"token": "'+gb_token+'"}';

    vJsonToSend := TStringStream.Create(j, TEncoding.UTF8);
    vResponseStream := TStringStream.Create('', TEncoding.UTF8);
    try
      try
        httpPedidos.Post(gb_base_url + '/cupons', vJsonToSend, vResponseStream);
        vResponse := vResponseStream.DataString;
      except
        on E: Exception do begin
          ShowMessage('Falha de conexão com o servidor.');
          Exit;
        end;
      end;
    finally
      FreeAndNil(vJsonToSend);
      FreeAndNil(vResponseStream);
    end;
  end;

  if vResponse <> '[]' then begin
    vJSONArray := TJSONArray(TJSONObject.ParseJSONValue(vResponse));
    try
      for vInt := 0 to Pred(vJSONArray.Count) do begin
        vObj   := TJSONObject(vJSONArray.Items[vInt]);
        vId    := StrToInt(vObj.GetValue('id').Value);

        if memPedido.Locate('Id', vId, []) then
          Continue;

        gravaMemTable(vObj, vId);
//        imprimirPedidos(vId);
      end;

    finally
      vJSONArray.Free;
    end;
  end;
end;

procedure TfPrincipal.carregaPedidosBanco;
var
  q1 : TFDQuery;
  vObj : TJSONObject;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('select id, json, status, (select count(*) from pedidos) as total,');
    q1.SQL.Add('       data, codigo_descricao, ');
    q1.SQL.Add('       (select MAX(codigo_descricao)');
    q1.SQL.Add('        from pedidos');
    q1.SQL.Add('        where data >= datetime(''now'', ''-1 day'')) as ultimo_codigo');
    q1.SQL.Add('from pedidos');
    q1.SQL.Add('where data >= datetime(''now'', ''-1 day'')');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.Open;

//    if (not q1.IsEmpty) and (FFirstLogin = 1) then begin
    if (not q1.IsEmpty) then begin
      gb_codigo   := q1.FieldByName('ultimo_codigo').AsInteger + 1;
//      gb_codigo   := gb_codigo - q1.FieldByName('total').AsInteger;
//      FFirstLogin := 2;
    end
    else begin
      gb_codigo := 1;
    end;

    while not q1.Eof do begin
      vObj := TJSONObject(TJSONObject.ParseJSONValue(q1.FieldByName('json').AsString));
      gravaMemTable(vObj, q1.FieldByName('id').AsInteger,
                    q1.FieldByName('status').AsInteger, 'S',
                    q1.FieldByName('codigo_descricao').AsInteger);
      q1.Next;
    end;

  finally
    FreeAndNil(q1);
  end;
end;

