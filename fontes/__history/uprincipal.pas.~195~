procedure TfPrincipal.repetirValidacao;
var
  vInt: Integer;
  vValido : boolean;
begin
  vValido := False;
  for vInt := 0 to 4 do begin
    vValido := validarToken;
    if vValido then
      Break;

    atualizarToken;
    Sleep(2000);
  end;

  if not vValido then begin
    if FQtdLogin > 1 then begin
      ShowMessage('Falha na conexão com o servidor. Tente novamente mais tarde!');
      Application.Terminate;
    end;
    
    desabilitaTela;

    Self.Hide;
    ShowMessage('Falha na conexão com o servidor. Tente novamente daqui alguns segundos!');  

    flogin := Tflogin.Create(nil);
    try
      flogin.Timer.Enabled := True;
      flogin.ShowModal;
    finally
      flogin.Free;
    end;
    FQtdLogin := FQtdLogin + 1;
  end;
end;

