unit uform_modelo_cadastro;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, uform_modelo_modal, Vcl.ExtCtrls,
  Vcl.StdCtrls, uclass_controle_tabela;

type
  Tfform_modelo_cadastro = class(Tfform_modelo_modal)
    Panel3: TPanel;
    bFechar: TButton;
    Bevel1: TBevel;
    bExcluir: TButton;
    bProximo: TButton;
    bUltimo: TButton;
    bNovo: TButton;
    bGravar: TButton;
    bAnterior: TButton;
    bPrimeiro: TButton;
    procedure bPrimeiroClick(Sender: TObject);
    procedure bExcluirClick(Sender: TObject);
    procedure bGravarClick(Sender: TObject);
    procedure bFecharClick(Sender: TObject);
    procedure bNovoClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
  private
    FTabela: TControleTabela;
    { Private declarations }
  public
    { Public declarations }
    procedure direcao(tag : integer); virtual; abstract;
    procedure excluir; virtual; abstract;
    procedure gravarRegistro; virtual; abstract;
    procedure novoRegistro; virtual; abstract;
    function  podeExcluir : boolean; virtual;
    function  confereCampos : boolean; virtual;
  published
    property Tabela : TControleTabela read FTabela write FTabela;
  end;

var
  fform_modelo_cadastro: Tfform_modelo_cadastro;

implementation

{$R *.dfm}

uses ulib_mensagens;

procedure Tfform_modelo_cadastro.bExcluirClick(Sender: TObject);
begin
  inherited;
  if not podeExcluir then begin
    Application.MessageBox('Não é possível excluir esse registro!','Aviso',MB_OK+MB_ICONSTOP);
//    MessageDlg('Registro não pode ser excluído!', mtWarning, [mbOK]);
  end
  else begin
    if MessageBox(WindowHandle,'Confirma exclusão deste registro?', 'Confirmação', MB_YESNO + MB_ICONQUESTION ) = IDNO then
      Exit;
    excluir;
//    if MessageDlg(
//       'Confirma exclusão do registro?',
//       mtConfirmation,
//       [mbYes, mbNo],
//       0
//    ) = mrYes then begin
//      excluir;
//    end;
  end;
end;

procedure Tfform_modelo_cadastro.bFecharClick(Sender: TObject);
begin
  inherited;
  Close;
end;

procedure Tfform_modelo_cadastro.bGravarClick(Sender: TObject);
begin
  inherited;
  if confereCampos then
    gravarRegistro;
end;

procedure Tfform_modelo_cadastro.bNovoClick(Sender: TObject);
begin
  inherited;
  novoRegistro;
end;

procedure Tfform_modelo_cadastro.bPrimeiroClick(Sender: TObject);
begin
  inherited;
  with Sender as TButton do
    direcao(Tag);
end;

function Tfform_modelo_cadastro.confereCampos: boolean;
begin
  Result := False;
end;

procedure Tfform_modelo_cadastro.FormCreate(Sender: TObject);
begin
  inherited;
  FTabela := nil;
end;

procedure Tfform_modelo_cadastro.FormDestroy(Sender: TObject);
begin
  inherited;
  FreeAndNil(FTabela);
end;

function Tfform_modelo_cadastro.podeExcluir: boolean;
begin
  Result := True;
end;

end.
