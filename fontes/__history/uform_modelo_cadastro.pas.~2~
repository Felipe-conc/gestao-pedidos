    bUltimo: TButton;
    bNovo: TButton;
    bGravar: TButton;
    bAnterior: TButton;
    bPrimeiro: TButton;
    procedure bPrimeiroClick(Sender: TObject);
  private
    FTabela: TControleTabela;
    { Private declarations }
  public
    { Public declarations }
    procedure direcao(tag : integer); virtual; abstract;
  published
    property Tabela : TControleTabela read FTabela write FTabela;
  end;

var
  fform_modelo_cadastro: Tfform_modelo_cadastro;

implementation

{$R *.dfm}

procedure Tfform_modelo_cadastro.bPrimeiroClick(Sender: TObject);
begin
  inherited;
