unit uform_modelo_cadastro;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, uform_modelo_modal, Vcl.ExtCtrls,
  Vcl.StdCtrls, uclass_controle_tabela;

type
