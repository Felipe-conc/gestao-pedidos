{$R *.dfm}

uses uclass_venda_externa;

procedure Tfcad_venda_externa.AtualizarGrid;
begin
  qVendas.Close;
  with Tabela as TTab_venda_externa do
    carregaVendasDia(qVendas, eData.Date);
end;

procedure Tfcad_venda_externa.atualizarResumo;
var
  vValorBruto, vTaxas, vValorLiquido : double;
begin
  vValorBruto   := eValorBruto.Value;

  if (eValorBruto.Value <> 0) and (eTxServ.Value <> 0) then begin
    FTxServico  := (eTxServ.Value / vValorBruto) * 100;
  end;

  eTxServ.Value := (vValorBruto * (FTxServico / 100));
  vTaxas        := eTxServAdicional.Value + eTxServ.Value;
  vValorLiquido := vValorBruto - vTaxas;

  lValorBruto.Caption   := 'R$ ' + FormatFloat('0.00', vValorBruto);
  lTotalTaxa.Caption    := '- R$ ' + FormatFloat('0.00', vTaxas);
  lValorLiquido.Caption := 'R$ ' + FormatFloat('0.00', vValorLiquido);

  lValorBruto.Width   := 216;
  lValorLiquido.Width := 216;
  lTotalTaxa.Width    := 216;

  lTxServ.Caption := 'Taxa Serviço ('+CurrToStr(FTxServico)+'%):';
end;

procedure Tfcad_venda_externa.bExcluirClick(Sender: TObject);
begin
//  inherited;
  if not podeExcluir then begin
    Application.MessageBox('Não é possível excluir esse registro!','Aviso',MB_OK+MB_ICONSTOP);
  end
  else begin
    if MessageDlg(
         'Deseja excluir essa venda do ' +
         gVendas.DataSource.DataSet.FieldByName('descricao').AsString +
         ' do dia ' +
         gVendas.DataSource.DataSet.FieldByName('data_venda').AsString +
         ' ?',
         mtConfirmation,
         [mbYes, mbNo],
         0
       ) = mrNo then
    begin
      Exit;
    end;
    excluir;
  end;
end;

procedure Tfcad_venda_externa.bNovoClick(Sender: TObject);
begin
  inherited;
  eData.Date := Date;
end;

procedure Tfcad_venda_externa.buscaCanalVenda;
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('select id, descricao, taxa_fixa');
    q1.SQL.Add('from canal_venda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := StrToInt(eCodCanalV.Text);
    q1.Open;
    if not q1.Eof then begin
      cbCanalVenda.KeyValue := q1.FieldByName('id').AsInteger;
      lTxServ.Caption       := 'Taxa Serviço ('+q1.FieldByName('taxa_fixa').AsString+'%):';
      eTxServ.Value         := 0;
      FTxServico            := q1.FieldByName('taxa_fixa').AsCurrency;
      atualizarResumo;
    end
    else begin
      eCodCanalV.Text       := '';
      cbCanalVenda.KeyValue := Null;
      eTxServ.Value         := 0;
      FTxServico            := 0;
      ShowMessage('Canal de Venda não encontrado!');
    end;
  finally
    FreeAndNil(q1);
  end;              
end;

procedure Tfcad_venda_externa.carregaCampos(AId: integer);
begin
  with Tabela as TTab_venda_externa do begin
    carregar(AId);
    if TabFlag = 'A' then begin
      eData.Date             := DataVenda;
      eNrPedidos.Text        := IntToStr(NumeroPedidos);
      cbCanalVenda.KeyValue  := IdCanalVenda;
      eCodCanalV.Text        := IntToStr(IdCanalVenda);
      eValorBruto.Value      := ValorBruto;
      eTxServ.Value          := Taxa_servico;
      eTxServAdicional.Value := Taxa_servico_adicional;

      atualizarResumo;
    end
    else begin
      novoRegistro;
    end;
  end;
end;

procedure Tfcad_venda_externa.cbCanalVendaClick(Sender: TObject);
begin
  inherited;
  if cbCanalVenda.Text <> '' then begin
    eCodCanalV.Text := IntToStr(qCanalVendaid.AsInteger);
    eCodCanalVExit(nil);
  end;
end;

function Tfcad_venda_externa.confereCampos: boolean;
begin
  Result := False;
  if cbCanalVenda.KeyValue = Null then begin
    ShowMessage('Selecione uma fonte de renda!');
    Exit;
  end;

  if eValorBruto.Value <= 0 then begin
    ShowMessage('Informe o valor bruto!');
    Exit;
  end;

  if not FEdicao then begin
    with Tabela as TTab_venda_externa do begin
      if canalVendaHoje(StrToInt(eCodCanalV.Text), eData.Date) then begin
        ShowMessage('Você já cadastrou uma venda para esse canal hoje!');
        Exit;
      end;
    end;

    if MessageBox(WindowHandle,'Deseja gravar esta venda? Lembre-se de que é permitida apenas uma venda por dia para cada canal de venda.', 'Confirmação', MB_YESNO + MB_ICONQUESTION ) = IDNO then
      Exit;
  end
  else begin
    if MessageBox(WindowHandle,'Deseja atualizar os valores desta venda?', 'Confirmação', MB_YESNO + MB_ICONQUESTION ) = IDNO then
      Exit;
  end;

  Result := True;
end;

procedure Tfcad_venda_externa.direcao(tag: integer);
begin
  inherited;

  with Tabela as TTab_venda_externa do begin
//    Codigo := StrToInt(Edit1.Text);
    direcao(tag);

    if TabFlag = 'A' then
      carregaCampos(Codigo);
  end;
end;

