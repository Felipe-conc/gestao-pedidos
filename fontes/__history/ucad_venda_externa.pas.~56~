//      Exit;
//    end;
end;

procedure Tfcad_venda_externa.eCodCanalVExit(Sender: TObject);
begin
  if eCodCanalV.Text <> '' then
    buscaCanalVenda
  else 
    eCodCanalV.Text := '';
end;

procedure Tfcad_venda_externa.eDataChange(Sender: TObject);
var
  vData: TDateTime;
begin
  inherited;
  vData := eData.Date;
  limpaCampos;

  qVendas.Close;
  with Tabela as TTab_venda_externa do
    carregaVendasDia(qVendas, vData);

  eCodCanalV.SetFocus;
end;

procedure Tfcad_venda_externa.eTxServAdicionalExit(Sender: TObject);
begin
  inherited;
  atualizarResumo;
end;

procedure Tfcad_venda_externa.FormCreate(Sender: TObject);
begin
  inherited;
  qCanalVenda.Close;
  qCanalVenda.Open;
end;

procedure Tfcad_venda_externa.FormShow(Sender: TObject);
begin
  inherited;
  Tabela := TTab_venda_externa.create;
  novoRegistro;
  eData.Date := Date;
end;

procedure Tfcad_venda_externa.gravarRegistro;
begin
  inherited;
  with Tabela as TTab_venda_externa do begin
    DataVenda              := eData.Date;
    NumeroPedidos          := StrToIntDef(eNrPedidos.Text, 0);
    IdCanalVenda           := cbCanalVenda.KeyValue;
    ValorBruto             := eValorBruto.Value;
    Taxa_servico           := eTxServ.Value;
    Taxa_servico_adicional := eTxServAdicional.Value;

    gravar;
  end;
  AtualizarGrid;
  novoRegistro;
  eData.Date := Date;
end;

procedure Tfcad_venda_externa.gVendasDblClick(Sender: TObject);
begin
  inherited;
  carregaCampos(gVendas.DataSource.DataSet.FieldByName('id').AsInteger);
  FEdicao := True;
end;

procedure Tfcad_venda_externa.limpaCampos;
begin
  eNrPedidos.Text := '';
  eCodCanalV.Text := '';
  cbCanalVenda.KeyValue  := -1;
  eValorBruto.Value      := 0;
  eTxServ.Value          := 0;
  eTxServAdicional.Value := 0;
  FTxServico             := 0;
  FEdicao                := False;

  lValorBruto.Width   := 216;
  lValorLiquido.Width := 216;
  lTotalTaxa.Width    := 216;

  gVendas.Refresh;
  qCanalVenda.Close;
  qCanalVenda.Open;

  atualizarResumo;
end;

procedure Tfcad_venda_externa.novoRegistro;
begin
  inherited;
  limpaCampos;
  with Tabela as TTab_venda_externa do begin
    limparCampos;
  end;
end;

function Tfcad_venda_externa.podeExcluir: boolean;
begin
  Result := True;
end;

end.
