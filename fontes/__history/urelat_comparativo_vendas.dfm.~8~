  object qRelat: TFDQuery
    Connection = dm.conexao
    SQL.Strings = (
      'select'
      '  substr(cv.descricao, 1, 100) AS descricao,'
      '  sum(v.valor_bruto) as total_bruto,'
      
        '  (sum(v.taxa_servico) + sum(v.taxa_adicional)) as total_taxa_se' +
        'rvico,'
      
        '  (sum(v.valor_bruto) - (sum(v.taxa_servico) + sum(v.taxa_adicio' +
        'nal))) as total_liquido,'
      '  sum(numero_pedidos) as quantidade'
      'from venda_externa v'
      'left join canal_venda cv on cv.id = v.id_canal_venda'
      'group by v.id_canal_venda')
