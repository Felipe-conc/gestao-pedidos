unit ucad_fonte_renda;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, uform_modelo_cadastro, Vcl.StdCtrls,
  Vcl.ExtCtrls, FnpNumericEdit;

type
  Tfcad_fonte_renda = class(Tfform_modelo_cadastro)
    eDescricao: TEdit;
    Label1: TLabel;
    eCodigo: TEdit;
    Label2: TLabel;
    Label3: TLabel;
    cbTipoTaxa: TComboBox;
    Label4: TLabel;
    Label5: TLabel;
    ePorcentagem: TFnpNumericEdit;
    eTaxaFixa: TFnpNumericEdit;
    procedure FormShow(Sender: TObject);
    procedure cbTipoTaxaClick(Sender: TObject);
  private
    { Private declarations }
    procedure direcao(tag : integer); override;
    procedure excluir; override;
    procedure gravarRegistro; override;
    procedure novoRegistro; override;
    function  podeExcluir : boolean; override;
    function  confereCampos : boolean; override;

    procedure carregaCampos(AId : integer);
    procedure limpaCampos;
    procedure alteraTipoTaxa;
  public
    { Public declarations }
  end;

var
  fcad_fonte_renda: Tfcad_fonte_renda;

implementation

{$R *.dfm}

uses uclass_fonte_renda;

{ Tfcad_fonte_renda }

procedure Tfcad_fonte_renda.alteraTipoTaxa;
begin
  case cbTipoTaxa.ItemIndex of
    0 : begin
      ePorcentagem.Enabled := False;
      eTaxaFixa.Enabled    := False;
    end;
    1 : begin
      ePorcentagem.Enabled := False;
      eTaxaFixa.Enabled    := True;
    end;
    2 : begin
      ePorcentagem.Enabled := True;
      eTaxaFixa.Enabled    := False;
    end;
    3 : begin
      ePorcentagem.Enabled := True;
      eTaxaFixa.Enabled    := True;
    end;
  end;
end;

procedure Tfcad_fonte_renda.carregaCampos(AId: integer);
begin
  with Tabela as TTab_fonte_renda do begin
    carregar(AId);
    if TabFlag = 'A' then begin
      eCodigo.Text         := IntToStr(Codigo);
      eDescricao.Text      := Descricao;
      cbTipoTaxa.ItemIndex := TipoTaxa;
      eTaxaFixa.Value      := Valor_taxa_fixa;
      ePorcentagem.Value   := Valor_porcentagem;
      alteraTipoTaxa;
    end
    else begin
      novoRegistro;
    end;
  end;
end;

procedure Tfcad_fonte_renda.cbTipoTaxaClick(Sender: TObject);
begin
  inherited;
  alteraTipoTaxa;
end;

function Tfcad_fonte_renda.confereCampos: boolean;
begin
  Result := False;
  if Trim(eDescricao.Text) = '' then begin
    ShowMessage('Descrição é obrigatória!');
    Exit;
  end;

  if cbTipoTaxa.ItemIndex = -1 then begin
    ShowMessage('Selecione um tipo de taxa!');
    Exit;
  end;
  Result := True;
end;

procedure Tfcad_fonte_renda.direcao(tag: integer);
begin
  inherited;
  with Tabela as TTab_fonte_renda do begin
    Codigo := StrToInt(eCodigo.Text);
    direcao(tag);

    if TabFlag = 'A' then
      carregaCampos(Codigo);
  end;
end;

procedure Tfcad_fonte_renda.excluir;
begin
  inherited;
  with Tabela as TTab_fonte_renda do begin
    Codigo := StrToInt(eCodigo.Text);

    if not podeExcluir then begin
      ShowMessage('Este registro está vinculado a outras tabelas e não pode ser excluído!');
      Exit;
    end;
    excluir;
  end;
  novoRegistro;
end;

procedure Tfcad_fonte_renda.FormShow(Sender: TObject);
begin
  inherited;
  Tabela := TTab_fonte_renda.create;
  novoRegistro;
end;

procedure Tfcad_fonte_renda.gravarRegistro;
begin
  inherited;
  with Tabela as TTab_fonte_renda do begin
    Codigo            := StrToInt(eCodigo.Text);
    Descricao         := Trim(eDescricao.Text);
    TipoTaxa          := cbTipoTaxa.ItemIndex;
    Valor_taxa_fixa   := eTaxaFixa.Value;
    Valor_porcentagem := ePorcentagem.Value;
    gravar;
  end;
  novoRegistro;
end;

procedure Tfcad_fonte_renda.limpaCampos;
begin
  eCodigo.Text         := '';
  eDescricao.Text      := '';
  cbTipoTaxa.ItemIndex := -1;
  eTaxaFixa.Value      := 0;
  ePorcentagem.Value   := 0;
  eTaxaFixa.Enabled    := False;
  ePorcentagem.Enabled := False;
  eDescricao.SetFocus;
end;

procedure Tfcad_fonte_renda.novoRegistro;
begin
  inherited;
  limpaCampos;
  with Tabela as TTab_fonte_renda do begin
    limparCampos;
    eCodigo.Text := IntToStr(proximaChave);
  end;
end;

function Tfcad_fonte_renda.podeExcluir: boolean;
begin
  Result := True;
end;

end.
