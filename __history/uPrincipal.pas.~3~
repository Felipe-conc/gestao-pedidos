  IdComponent, IdTCPConnection, IdTCPClient, IdHTTP, Data.DB,
  FireDAC.Comp.DataSet, FireDAC.Comp.Client, System.JSON, Vcl.StdCtrls,
  Vcl.DBCtrls, frxClass;

type
  TfPrincipal = class(TForm)
    Panel1: TPanel;
    dsPedido: TDataSource;
    httpPedidos: TIdHTTP;
    IdHTTPServer1: TIdHTTPServer;
    memPedido: TFDMemTable;
    Timer1: TTimer;
    frqPedido: TfrxReport;
    DBLookupComboBox1: TDBLookupComboBox;
    Label1: TLabel;
    memPedidoId: TIntegerField;
    memPedidoDescricao: TStringField;
    memPedidoImpresso: TStringField;

  private
    { Private declarations }
    procedure carregaPedidos;
    procedure imprimirPedidos;
  public
    { Public declarations }
  end;

var
  fPrincipal: TfPrincipal;

implementation

{$R *.dfm}



{ TfPrincipal }

procedure TfPrincipal.carregaPedidos;
var
  vResponse : string;
  vJSONArray : TJSONArray;
  vObj : TJSONObject;
  vInt: Integer;
begin
  vResponse := httpPedidos.Get('get/pedidos');

  if vResponse <> '' then begin
    vJSONArray := TJSONObject.ParseJSONValue(vResponse);

    try

      for vInt := 0 to vJSONArray.Count do begin

        vObj := vJSONArray.Items[vInt];

        memPedido.Append;
        memPedidoId.AsInteger       := vObj.GetValue('');
        memPedidoDescricao.AsString := vObj.GetValue('');
        memPedidoImpresso.AsString  := vObj.GetValue('Impresso');
        memPedido.Post;

        if memPedidoImpresso.AsString = 'N' then begin

          frqPedido.PrepareReport();
          frqPedido.Print;
        end;


      end;

    finally
      vJSONArray.Free;
    end;

    //imprimirPedidos;

  end;


end;


