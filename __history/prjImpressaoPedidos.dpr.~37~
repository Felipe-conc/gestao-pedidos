program prjImpressaoPedidos;

uses
  Vcl.Forms,
  System.SysUtils,
  System.UITypes,
  ulib_operacionais,
  udm in 'fontes\udm.pas' {dm: TDataModule},
  uglobal_vars in 'fontes\uglobal_vars.pas',
  uform_modelo in 'fontes\uform_modelo.pas' {fform_modelo},
  uform_modelo_modal in 'fontes\uform_modelo_modal.pas' {fform_modelo_modal},
  ulogin in 'fontes\ulogin.pas' {flogin},
  uprincipal in 'fontes\uprincipal.pas' {fPrincipal},
  uselec_estabelecimento in 'fontes\uselec_estabelecimento.pas' {fSelec_Estabelecimento},
  urelat_pedidos in 'fontes\urelat_pedidos.pas' {fRelat_pedidos},
  udm_fastreport in 'fontes\udm_fastreport.pas' {dm_fastreport: TDataModule},
  uform_modelo_cadastro in 'fontes\uform_modelo_cadastro.pas' {fform_modelo_cadastro},
  uclass_controle_tabela in 'classes\uclass_controle_tabela.pas',
  ucad_canal_venda in 'fontes\ucad_canal_venda.pas' {fcad_canal_venda},
  uclass_canal_venda in 'classes\uclass_canal_venda.pas',
  ucad_venda_externa in 'fontes\ucad_venda_externa.pas' {fcad_venda_externa},
  uclass_venda_externa in 'classes\uclass_venda_externa.pas',
  urelat_comparativo_vendas in 'fontes\urelat_comparativo_vendas.pas' {fRelat_comparativo_vendas},
  uconfig_impressora in 'fontes\uconfig_impressora.pas' {fconfig_impressora},
  uthr_cupons in 'fontes\uthr_cupons.pas';

{$R *.res}

begin
  uniqueInstance('ACHEIVC_IMP_PEDIDOS');

  Application.Initialize;
  Application.MainFormOnTaskbar := False;
  Application.ShowMainForm := False;

  Application.CreateForm(Tdm, dm);
  Application.CreateForm(Tflogin, flogin);
  Application.CreateForm(Tdm_fastreport, dm_fastreport);
  if flogin.ShowModal = mrOk then begin
    FreeAndNil(flogin);
    Application.CreateForm(TfPrincipal, fPrincipal);
    Application.Run;
  end
  else begin
    Application.Terminate;
  end;
end.
