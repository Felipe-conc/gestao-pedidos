unit uclass_venda_externa;

interface

uses uclass_controle_tabela, FireDAC.Comp.Client, sysUtils, udm;

type
  TTab_venda_externa = class(TControleTabela)
    private
    FTabFlag: string;
    FDescricao: string;
    FCodigo: integer;
    FNumeroPedidos: integer;
    FTaxa_servico_adicional: currency;
    FTaxa_servico: currency;
    FValorBruto: currency;
    FIdCanalVenda: integer;
    FDataVenda: TDateTime;
    procedure gravar; override;
    procedure inserir; override;
    procedure alterar; override;
    procedure excluir; override;
    procedure limparCampos; override;
    procedure direcao(tag : integer); override;
    function  podeExcluir : boolean; override;
    function  confereCampos: boolean; override;
    function  buscaRegistro(AId : integer) : boolean; override;
  public
    procedure carregar(AId : integer);
    procedure carregaData(AData : TDateTime);
    procedure carregaVendasDia(AQuery : TFDQuery; AData : TDateTime);
    function  proximaChave : integer;
    function  canalVendaHoje(AIdCanalVenda : integer; AData : TDateTime) : boolean;
  published
    property Codigo : integer read FCodigo write FCodigo;
    property Descricao : string read FDescricao write FDescricao;
    property DataVenda: TDateTime read FDataVenda write FDataVenda;
    property NumeroPedidos : integer read FNumeroPedidos write FNumeroPedidos;
    property Taxa_servico : currency read FTaxa_servico write FTaxa_servico;
    property ValorBruto : currency read FValorBruto write FValorBruto;
    property IdCanalVenda : integer read FIdCanalVenda write FIdCanalVenda;
    property Taxa_servico_adicional: currency read FTaxa_servico_adicional write FTaxa_servico_adicional;
    property TabFlag : string read FTabFlag write FTabFlag;
  end;


implementation

{ TTab_venda_externa }

uses uglobal_vars;

procedure TTab_venda_externa.alterar;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;

    q1.SQL.Clear;
    q1.SQL.Add('update venda_externa');
    q1.SQL.Add('set data_venda     = :data_venda,');
    q1.SQL.Add('    id_canal_venda = :id_canal_venda,');
    q1.SQL.Add('    valor_bruto    = :valor_bruto,');
    q1.SQL.Add('    numero_pedidos = :numero_pedidos,');
    q1.SQL.Add('    taxa_servico   = :taxa_servico,');
    q1.SQL.Add('    taxa_adicional = :taxa_adicional');
    q1.SQL.Add('where id = :id');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('id').AsInteger                 := FCodigo;
    q1.ParamByName('data_venda').AsDateTime        := FDataVenda;
    q1.ParamByName('id_canal_venda').AsInteger     := FIdCanalVenda;
    q1.ParamByName('valor_bruto').AsCurrency       := FValorBruto;
    q1.ParamByName('numero_pedidos').AsInteger     := FNumeroPedidos;
    q1.ParamByName('taxa_servico').AsCurrency      := FTaxa_servico;
    q1.ParamByName('taxa_adicional').AsCurrency    := FTaxa_servico_adicional;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;

    q1.ExecSQL;
    dm.conexao.Commit;
  finally
    FreeAndNil(q1);
  end;
end;

function TTab_venda_externa.buscaRegistro(AId: integer): boolean;
begin

end;

function TTab_venda_externa.canalVendaHoje(AIdCanalVenda : integer; AData : TDateTime): boolean;
var
  q1 : TFDQuery;
begin
  Result := False;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.SQL.Clear;
    q1.SQL.Add('select id');
    q1.SQL.Add('from venda_externa');
    q1.SQL.Add('where date(data_venda) = date(:data_venda)');
    q1.SQL.Add('  and id_canal_venda = :id_canal_venda');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('data_venda').AsDateTime        := AData;
    q1.ParamByName('id_canal_venda').AsInteger     := AIdCanalVenda;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.Open;

    if not q1.Eof then
      Result := True

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_venda_externa.carregaData(AData: TDateTime);
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.SQL.Clear;
    q1.SQL.Add('select id');
    q1.SQL.Add('from venda_externa');
    q1.SQL.Add('where date(data_venda) = date(:data_venda)');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('data_venda').AsDateTime := AData;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.Open;

    if not q1.Eof then
      carregar(q1.FieldByName('id').AsInteger)
    else
      limparCampos;

  finally
    FreeAndNil(q1);
  end;
end;
procedure TTab_venda_externa.carregar(AId: integer);
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.SQL.Clear;
    q1.SQL.Add('select *');
    q1.SQL.Add('from venda_externa');
    q1.SQL.Add('where id = :id');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('id').AsInteger := AId;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.Open;

    if not q1.Eof then begin
      FCodigo                 := q1.FieldByName('id').AsInteger;
      FDataVenda              := q1.FieldByName('data_venda').AsDateTime;
      FIdCanalVenda           := q1.FieldByName('id_canal_venda').AsInteger;
      FValorBruto             := q1.FieldByName('valor_bruto').AsCurrency;
      FNumeroPedidos          := q1.FieldByName('numero_pedidos').AsInteger;
      FTaxa_servico           := q1.FieldByName('taxa_servico').AsCurrency;
      FTaxa_servico_adicional := q1.FieldByName('taxa_adicional').AsCurrency;

      FTabFlag := 'A';
    end
    else begin
      limparCampos;
    end;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_venda_externa.carregaVendasDia(AQuery: TFDQuery;
  AData: TDateTime);
begin
  AQuery.SQL.Clear;
  AQuery.SQL.Add('select v.id, v.data_venda, v.valor_bruto, v.numero_pedidos, ');
  AQuery.SQL.Add('       v.taxa_servico, v.taxa_adicional, ');
  AQuery.SQL.Add('       substr(c.descricao, 1, 100) AS descricao ');
  AQuery.SQL.Add('from venda_externa v');
  AQuery.SQL.Add('left join canal_venda c on c.id = v.id_canal_venda');
  AQuery.SQL.Add('where date(data_venda) = date(:data_venda)');
  AQuery.SQL.Add('  and v.id_estabelecimento = :id_estabelecimento');

  AQuery.ParamByName('data_venda').AsDateTime        := AData;
  AQuery.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;

  AQuery.Open;

end;

function TTab_venda_externa.confereCampos: boolean;
begin

end;

procedure TTab_venda_externa.direcao(tag: integer);
begin
  inherited;

end;

procedure TTab_venda_externa.excluir;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;

    q1.SQL.Clear;
    q1.SQL.Add('delete from venda_externa');
    q1.SQL.Add('where id = :id');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('id').AsInteger := FCodigo;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;

    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_venda_externa.gravar;
begin
  inherited;
  if FTabFlag = 'I' then
    inserir
  else
    alterar;
end;

procedure TTab_venda_externa.inserir;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;

    q1.SQL.Clear;
    q1.SQL.Add('insert into venda_externa ');
    q1.SQL.Add('(data_venda, id_canal_venda, valor_bruto, ');
    q1.SQL.Add(' numero_pedidos, taxa_servico, taxa_adicional, id_estabelecimento)');
    q1.SQL.Add('values ');
    q1.SQL.Add('(:data_venda, :id_canal_venda, :valor_bruto, ');
    q1.SQL.Add(' :numero_pedidos, :taxa_servico, :taxa_adicional, :id_estabelecimento)');
    q1.ParamByName('data_venda').AsDateTime := FDataVenda;
    q1.ParamByName('id_canal_venda').AsInteger := FIdCanalVenda;
    q1.ParamByName('valor_bruto').AsCurrency := FValorBruto;
    q1.ParamByName('numero_pedidos').AsInteger := FNumeroPedidos;
    q1.ParamByName('taxa_servico').AsCurrency := FTaxa_servico;
    q1.ParamByName('taxa_adicional').AsCurrency := FTaxa_servico_adicional;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;

    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_venda_externa.limparCampos;
begin
  FCodigo                 := -1;
  FDataVenda              := Date;
  FIdCanalVenda           := 0;
  FValorBruto             := 0;
  FNumeroPedidos          := 0;
  FTaxa_servico           := 0;
  FTaxa_servico_adicional := 0;
  FTabFlag                := 'I';
end;

function TTab_venda_externa.podeExcluir: boolean;
begin
  Result := True;
end;

function TTab_venda_externa.proximaChave: integer;
begin

end;

end.
