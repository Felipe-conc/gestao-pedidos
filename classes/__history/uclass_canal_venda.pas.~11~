unit uclass_canal_venda;

interface

uses
  uclass_controle_tabela, FireDAC.Comp.Client, sysUtils;

type
  TTab_canal_venda = class(TControleTabela)
  private
    FCodigo: integer;
    FDescricao: string;
    FTabFlag: string;
    FValor_taxa_fixa: currency;
    procedure gravar; override;
    procedure inserir; override;
    procedure alterar; override;
    procedure excluir; override;
    procedure limparCampos; override;
    procedure direcao(tag : integer); override;
    function  podeExcluir : boolean; override;
    function  confereCampos: boolean; override;
    function  buscaRegistro(AId : integer) : boolean; override;
  public
    procedure carregar(AId : integer);
    function proximaChave : integer;
  published
    property Codigo : integer read FCodigo write FCodigo;
    property Descricao : string read FDescricao write FDescricao;
    property Valor_taxa_fixa : currency read FValor_taxa_fixa write FValor_taxa_fixa;
    property TabFlag : string read FTabFlag write FTabFlag;
end;

implementation

{ TTab_fonte_renda }

uses udm, uglobal_vars;

procedure TTab_canal_venda.alterar;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('update canal_venda');
    q1.SQL.Add('set descricao = :descricao, ');
    q1.SQL.Add('    taxa_fixa = :taxa_fixa');
    q1.SQL.Add('where id = :id');
    q1.SQL.Add('  and id_estabelecimento = :id_estabelecimento');

    q1.ParamByName('descricao').AsString           := FDescricao;
    q1.ParamByName('taxa_fixa').AsCurrency         := FValor_taxa_fixa;
    q1.ParamByName('id').AsInteger                 := FCodigo;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;

    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

function TTab_canal_venda.buscaRegistro(AId: integer): boolean;
var
  q1 : TFDQuery;
begin
  Result := False;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;

    q1.SQL.Add('select id');
    q1.SQL.Add('from canal_venda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := Trunc(AId);
    q1.Open;

    if not q1.Eof then begin
      carregar(AId);
      Result := True;
    end

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_canal_venda.carregar(AId: integer);
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('select descricao, taxa_fixa');
    q1.SQL.Add('from canal_venda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := AId;
    q1.Open;

    if not q1.Eof then begin
      FCodigo            := AId;
      FDescricao         := q1.FieldByName('descricao').AsString;
      FValor_taxa_fixa   := q1.FieldByName('taxa_fixa').AsCurrency;
      FTabFlag           := 'A';
    end
    else begin
      limparCampos;
    end;

  finally
    FreeAndNil(q1);
  end;
end;

function TTab_canal_venda.confereCampos: boolean;
begin

end;

procedure TTab_canal_venda.direcao(tag: integer);
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;

    case tag of
      1 : begin
        q1.SQL.Add('select min(id) from canal_venda');
      end;
      2 : begin
        q1.SQL.Add('select max(id) from canal_venda');
        q1.SQL.Add('where id < :id ');
        q1.ParamByName('id').AsInteger := FCodigo;
      end;
      3 : begin
        q1.SQL.Add('select min(id) from canal_venda');
        q1.SQL.Add('where id > :id ');
        q1.ParamByName('id').AsInteger := FCodigo;
      end;
      4 : begin
        q1.SQL.Add('select max(id) from canal_venda');
      end;
    end;
    q1.Open;

    if not q1.Fields[0].IsNull then
      carregar(q1.Fields[0].AsInteger);

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_canal_venda.excluir;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('delete from canal_venda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := FCodigo;
    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_canal_venda.gravar;
begin
  inherited;
  if FTabFlag = 'I' then
    inserir
  else
    alterar;
end;

procedure TTab_canal_venda.inserir;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('insert into canal_venda (descricao, taxa_fixa, id_estabelecimento)');
    q1.SQL.Add('values (:descricao, :taxa_fixa, :id_estabelecimento)');
    q1.ParamByName('descricao').AsString           := FDescricao;
    q1.ParamByName('taxa_fixa').AsCurrency         := FValor_taxa_fixa;
    q1.ParamByName('id_estabelecimento').AsInteger := gb_estabelecimento;
    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_canal_venda.limparCampos;
begin
  inherited;
  FCodigo            := -1;
  FDescricao         := '';
  FValor_taxa_fixa   := 0;
  FTabFlag           := 'I';
end;

function TTab_canal_venda.podeExcluir: boolean;
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('select count(*) FROM (');
    q1.SQL.Add('  select 1 as qtd from pedidos where id_canal_venda = :id_canal_venda');
    q1.SQL.Add(')');
    q1.ParamByName('id_canal_venda').AsInteger := Codigo;
    q1.Open;

    Result := q1.Fields[0].AsInteger <= 0;
  finally
    FreeAndNil(q1);
  end;
end;

function TTab_canal_venda.proximaChave: integer;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('select max(id) from canal_venda');
    q1.Open;

    if q1.Fields[0].IsNull then
      Result := 1
    else
      Result := q1.Fields[0].AsInteger + 1;

  finally
    FreeAndNil(q1);
  end;
end;

end.
