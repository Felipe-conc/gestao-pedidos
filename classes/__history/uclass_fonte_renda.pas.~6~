unit uclass_fonte_renda;

interface

uses
  uclass_controle_tabela, FireDAC.Comp.Client, sysUtils;

type
  TTab_fonte_renda = class(TControleTabela)
  private
    FCodigo: integer;
    FDescricao: string;
    FTabFlag: string;
    FTipoTaxa: integer;
    FValor_taxa_fixa: currency;
    FValor_porcentagem: currency;
    procedure gravar; override;
    procedure inserir; override;
    procedure alterar; override;
    procedure excluir; override;
    procedure limparCampos; override;
    procedure direcao(tag : integer); override;
    function  podeExcluir : boolean; override;
    function  confereCampos: boolean; override;
    function  buscaRegistro(AId : integer) : boolean; override;
  public
    procedure carregar(AId : integer);
    function proximaChave : integer;
  published
    property Codigo : integer read FCodigo write FCodigo;
    property Descricao : string read FDescricao write FDescricao;
    property TipoTaxa : integer read FTipoTaxa write FTipoTaxa;
    property Valor_taxa_fixa : currency read FValor_taxa_fixa write FValor_taxa_fixa;
    property Valor_porcentagem : currency read FValor_porcentagem write FValor_porcentagem;
    property TabFlag : string read FTabFlag write FTabFlag;
end;

implementation

{ TTab_fonte_renda }

uses udm;

procedure TTab_fonte_renda.alterar;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('update fonte_renda');
    q1.SQL.Add('set descricao = :descricao, ');
    q1.SQL.Add('    tipo_taxa = :tipo_taxa, ');
    q1.SQL.Add('    valor_taxa_fixa = :valor_taxa_fixa, ');
    q1.SQL.Add('    valor_porcentagem = :valor_porcentagem');
    q1.SQL.Add('where id = :id');

    q1.ParamByName('descricao').AsInteger         := FDescricao;
    q1.ParamByName('tipo_taxa').AsInteger         := FTipoTaxa;
    q1.ParamByName('valor_taxa_fixa').AsInteger   := FValor_taxa_fixa;
    q1.ParamByName('valor_porcentagem').AsInteger := FValor_porcentagem;
    q1.ParamByName('id').AsInteger                := FCodigo;

    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

function TTab_fonte_renda.buscaRegistro(AId: integer): boolean;
var
  q1 : TFDQuery;
begin
  Result := False;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;

    q1.SQL.Add('select id');
    q1.SQL.Add('from fonte_renda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := Trunc(AId);
    q1.Open;

    if not q1.Eof then begin
      carregar(AId);
      Result := True;
    end

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_fonte_renda.carregar(AId: integer);
var
  q1 : TFDQuery;
begin
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('select descricao, tipo_taxa, valor_taxa_fixa, valor_porcentagem');
    q1.SQL.Add('from fonte_renda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := AId;
    q1.Open;

    if not q1.Eof then begin
      FCodigo            := AId;
      FDescricao         := q1.FieldByName('descricao').AsString;
      FTipoTaxa          := q1.FieldByName('tipo_taxa').AsInteger;
      FValor_taxa_fixa   := q1.FieldByName('valor_taxa_fixa').AsCurrency;
      FValor_porcentagem := q1.FieldByName('valor_porcentagem').AsCurrency;
      FTabFlag           := 'A';
    end
    else begin
      limparCampos;
    end;

  finally
    FreeAndNil(q1);
  end;
end;

function TTab_fonte_renda.confereCampos: boolean;
begin

end;

procedure TTab_fonte_renda.direcao(tag: integer);
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;

    case tag of
      1 : begin
        q1.SQL.Add('select min(id) from fonte_renda');
      end;
      2 : begin
        q1.SQL.Add('select max(id) from fonte_renda');
        q1.SQL.Add('where id < :id ');
        q1.ParamByName('id').AsInteger := FCodigo;
      end;
      3 : begin
        q1.SQL.Add('select min(id) from fonte_renda');
        q1.SQL.Add('where id > :id ');
        q1.ParamByName('id').AsInteger := FCodigo;
      end;
      4 : begin
        q1.SQL.Add('select max(id) from fonte_renda');
      end;
    end;
    q1.Open;

    if q1.Fields[0].AsInteger > 0 then
      carregar(q1.Fields[0].AsInteger);

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_fonte_renda.excluir;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('delete from fonte_renda');
    q1.SQL.Add('where id = :id');
    q1.ParamByName('id').AsInteger := FCodigo;
    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_fonte_renda.gravar;
begin
  inherited;
  if FTabFlag = 'I' then
    inserir
  else
    alterar;
end;

procedure TTab_fonte_renda.inserir;
var
  q1 : TFDQuery;
begin
  inherited;
  q1 := TFDQuery.Create(nil);
  try
    q1.Connection := dm.conexao;
    q1.Close;
    q1.SQL.Clear;
    q1.SQL.Add('insert into fonte_renda (descricao, tipo_taxa, valor_taxa_fixa, valor_porcentagem)');
    q1.SQL.Add('values (:descricao, :tipo_taxa, :valor_taxa_fixa, :valor_porcentagem)');
    q1.ParamByName('descricao').AsInteger         := FDescricao;
    q1.ParamByName('tipo_taxa').AsInteger         := FTipoTaxa;
    q1.ParamByName('valor_taxa_fixa').AsInteger   := FValor_taxa_fixa;
    q1.ParamByName('valor_porcentagem').AsInteger := FValor_porcentagem;
    q1.ExecSQL;
    dm.conexao.Commit;

  finally
    FreeAndNil(q1);
  end;
end;

procedure TTab_fonte_renda.limparCampos;
begin
  inherited;
  FCodigo            := -1;
  FDescricao         := '';
  FTipoTaxa          := -1;
  FValor_taxa_fixa   := 0;
  FValor_porcentagem := 0;
  FTabFlag           := 'I';
end;

function TTab_fonte_renda.podeExcluir: boolean;
begin

end;

function TTab_fonte_renda.proximaChave: integer;
begin

end;

end.
